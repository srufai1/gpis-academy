# Copy to apps/web/.env.local and fill in from your Supabase project (Settings -> API).
# Names only here; never commit a value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Check results (T19). Server only: never give these the NEXT_PUBLIC_ prefix.
# Each is 64 hex characters, and they must differ. How to make and set them:
# docs/runbook-check-runs.md
ACADEMY_CHALLENGE_KEY=
ACADEMY_RECORD_KEY=
